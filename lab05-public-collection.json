{
  "info": {
    "name": "Lab05 — Нэмэлт нийтийн API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "GET users: статус, массив, эхний нэр",
      "request": {
        "method": "GET",
        "header": [],
        "url": "https://jsonplaceholder.typicode.com/users"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP статус 200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"Хариу нь массив\", function () { pm.expect(pm.response.json()).to.be.an(\"array\"); });",
              "pm.test(\"Эхний хэрэглэгч Leanne Graham\", function () { pm.expect(pm.response.json()[0].name).to.eql(\"Leanne Graham\"); });"
            ]
          }
        }
      ]
    }
  ]
}
